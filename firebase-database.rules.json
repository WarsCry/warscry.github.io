{
  "rules": {
    "scores": {
      "$game": {
        ".read": true,
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || newData.child('score').val() >= data.child('score').val())",
          ".validate": "newData.hasChildren(['uid', 'name', 'score', 'display', 'detail', 'at'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
          },
          "display": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "detail": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
